# Local development only. Copy to .env and fill in; never commit real values.
# Production takes everything from GitHub secrets - see docs/deployment.md.

# --- LiveKit Cloud (cloud.livekit.io -> Settings -> API keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini Live API (aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_VOICE=Puck
GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LANGUAGE=          # leave empty: native-audio models take the accent from the prompt
# Languages speech is transcribed in (comma-separated BCP-47). Empty = auto-detect.
TRANSCRIPTION_LANGUAGES=en-IN

# --- Agent wiring ---
AGENT_NAME=sabith-assistant
# PHONE_NUMBER=+1...        # printed by the provisioning script

# --- Storage API: the Worker in web/ (`npm run dev` serves it on port 5173) ---
# Leave BACKEND_BASE_URL empty to run the agent without storing anything.
BACKEND_BASE_URL=http://localhost:5173
BACKEND_API_KEY=local-dev-key
