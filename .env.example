# Copy to .env and fill in. Never commit real values.

# --- LiveKit Cloud (cloud.livekit.io -> Settings -> API keys, or: lk app env -w) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini Live API (aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_VOICE=Puck
# GEMINI_LIVE_MODEL=        # empty = plugin default
# GEMINI_LANGUAGE=en-US     # only if your chosen model needs an explicit language

# --- Agent wiring ---
AGENT_NAME=sabith-assistant
# PHONE_NUMBER=+1...        # printed by the provisioning script

# --- API service (tokens, transcripts, messages) ---
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5433/voice_assistant
# Where the agent posts transcripts/messages. Leave empty to run the agent alone.
BACKEND_BASE_URL=http://127.0.0.1:8000
# Shared secret for the private endpoints. Set this on any public deployment.
BACKEND_API_KEY=
# Sites allowed to embed the widget, comma-separated ("*" = any).
EMBED_ALLOWED_ORIGINS=*
