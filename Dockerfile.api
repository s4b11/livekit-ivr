# syntax=docker/dockerfile:1
# Container image for the API service: tokens, transcripts, messages, the embed
# widget, and the React voice UI. Host it anywhere that runs containers:
#   docker build -f Dockerfile.api -t voice-assistant-api .

# --- Web UI build ---
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# --- API service ---
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY . .
COPY --from=web /web/dist ./src/voice_assistant/api/static/app
RUN uv sync --locked --no-dev

RUN adduser --disabled-password --gecos "" --uid 10001 appuser
USER appuser

EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "voice_assistant.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
